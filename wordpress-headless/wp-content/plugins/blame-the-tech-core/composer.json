{
  "name": "blame-the-tech/core",
  "description": "Sever-side content model and API surface for Blame The Tech.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "Blame\\Core\\": "includes/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4"
    }
  },
  "require-dev": {
    "php-stubs/wp-cli-stubs": "~2.11.0"
  }
}
