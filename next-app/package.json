{
  "name": "btt-next-app",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Blame The Tech - front end for the headless WordPress API",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "blame": "tsx scripts/blame.ts",
    "blame:mjs": "node scripts/blame.mjs",
    "type-check": "tsc --noEmit",
    "typecheck": "npm run type-check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run type-check && npm run lint && npm run format:check",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts && git diff --exit-code -- src/gql/",
    "schema:pull": "cd ../wordpress-headless && docker compose run --rm wpcli wp graphql generate-static-schema --output=/var/www/html/wp-content/plugins/blame-the-tech-core/schema.graphql && mv wp-content/plugins/blame-the-tech-core/schema.graphql schema.graphql",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "e2e:reset": "cd ../wordpress-headless && test \"$(head -1 ../fixtures/seeded.sql)\" = \"$(docker compose run --rm -T wpcli wp blame fixture status | tr -d '\\r')\" || { echo 'fixtures/seeded.sql is stale — re-export it (Lesson 12.4 Step 5)'; exit 1; } && docker compose run --rm -T wpcli wp blame fixture load < ../fixtures/seeded.sql && { curl -sf -o /dev/null http://127.0.0.1:3000/en || echo 'cache warm skipped: nothing on :3000'; }"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/client-preset": "^6.2.0",
    "@next/eslint-plugin-next": "^16.3.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "graphql": "^17.0.2",
    "lucide-react": "^1.54.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  }
}
