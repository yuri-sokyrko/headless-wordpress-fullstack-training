// next-app/tsconfig.json
{
  "compilerOptions": {
    /* ── Language and libraries ─────────────────────────────────────── */
    "target": "ES2023",
    // CHANGED: a browser exists now. DOM gives you `document` and the element
    // types; DOM.Iterable makes NodeList and FileList work in a for..of.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // WAS "react-jsx" (Lesson 08.1, for esbuild). Next's compiler transforms JSX itself,
    // so TypeScript must hand it over untouched.
    "jsx": "react-jsx",
    // The TS language-service plugin: it type-checks Server/Client Component rules in
    // your editor — a misplaced `useState` is underlined before you run a build.
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Cache type information between runs. `next build` writes .tsbuildinfo; it is gitignored.
    "incremental": true,
    // React's types travel with its imports, so only @types/node is global.
    "types": ["node"],
    /* ── Modules ────────────────────────────────────────────────────── */
    // CHANGED: emit plain ES modules and let the bundler decide the rest.
    "module": "ESNext",
    // CHANGED: resolve the way esbuild, Vite and Next do — extensionless
    // specifiers, "exports" maps honoured, no CommonJS interop guesswork.
    "moduleResolution": "bundler",
    // NEW: one alias for the whole project. `@/types/content`, never
    // `../../../types/content`. The Vite config repeats it in Step 4.
    // "baseUrl": ".", <- removed the line
    "paths": {
      "@/*": ["./src/*"]
    },
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    /* ── Output ─────────────────────────────────────────────────────── */
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    /* ── Correctness — untouched. All of Lesson 07.3 still applies. ─── */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  // next-env.d.ts is generated by Next on first run and declares the JSX and image types.
  // .next/types/**/*.ts is generated route typing — it is what makes a typo in a
  // `generateStaticParams` return value a compile error.
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.{ts,tsx}",
    "src/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    ".next/dev/types/**/*.ts",
    "next.config.ts",
    "codegen.ts"
  ],
  "exclude": ["node_modules"]
}
