{
  // ─────────────────────────────────────────────────────────────────────────
  //  Blame The Tech — committed workspace settings
  //
  //  Committed on purpose (Lesson 07.5 §"Committing .vscode/settings.json"):
  //  the alternative is every contributor configuring format-on-save
  //  independently and one of them not doing it, which arrives as a 400-line
  //  whitespace diff. Only settings that affect the ARTEFACT belong here —
  //  personal taste (font size, zoom, minimap, autosave) belongs in your own
  //  User settings, where it does not follow anyone else around.
  // ─────────────────────────────────────────────────────────────────────────

  // ── Editor ───────────────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.trimAutoWhitespace": true,
  // One ruler, at next-app/.prettierrc's printWidth. Two rulers at 80 and 120
  // would both be lies — Prettier wraps at 100 and nothing wraps at 80.
  "editor.rulers": [100],
  // Tailwind class strings and GraphQL documents are strings; without this the
  // IntelliSense that Module 11 and Module 10 depend on stays silent inside quotes.
  "editor.quickSuggestions": {
    "strings": true
  },

  // ── Files ────────────────────────────────────────────────────────────────
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.associations": {
    // phpcs.xml.dist (Lesson 07.5) and phpunit.xml.dist (Lesson 23.4) open as
    // plain text otherwise — no highlighting, no tag closing, no folding on the
    // two config files you edit most while fighting the sniffer.
    "*.xml.dist": "xml",
    ".env.example": "dotenv"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true
    // `vendor/` is deliberately NOT hidden: Modules 23 and 24 ask you to read
    // what is in there (wp-phpunit, the WordPress stubs) even though you never
    // edit it.
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/vendor/**": true,
    "**/.next/**": true,
    "**/build/**": true,
    "**/coverage/**": true,
    "**/playwright-report/**": true,
    "**/test-results/**": true,
    "**/.lighthouseci/**": true
  },

  // ── Search ───────────────────────────────────────────────────────────────
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/.next": true,
    "**/build": true,
    "**/coverage": true,
    "**/playwright-report": true,
    "**/test-results": true,
    // Generated by `npm run codegen` (Module 10). Committed, so grep finds it
    // constantly and it is never the file you meant.
    "**/src/gql": true,
    "**/package-lock.json": true,
    "**/composer.lock": true
  },

  // ── PHP ──────────────────────────────────────────────────────────────────
  //  Two extensions own PHP here: Intelephense for language intelligence,
  //  phpsab for PHP_CodeSniffer. Both are in .vscode/extensions.json.
  //
  //  WordPress core is NOT on disk — it lives in the `btt-wp-core` Docker
  //  volume (Lesson 02.2) — so Intelephense cannot index it. `wordpress` in
  //  the stub list below is what makes `get_post()` resolve instead of
  //  showing up as an undefined function on every line.
  "intelephense.environment.phpVersion": "8.4",
  "intelephense.stubs": [
    "Core",
    "SPL",
    "standard",
    "superglobals",
    "date",
    "json",
    "pcre",
    "mbstring",
    "mysqli",
    "PDO",
    "curl",
    "gd",
    "exif",
    "fileinfo",
    "filter",
    "hash",
    "iconv",
    "intl",
    "libxml",
    "openssl",
    "session",
    "SimpleXML",
    "sodium",
    "tokenizer",
    "xml",
    "xmlreader",
    "xmlwriter",
    "zip",
    "zlib",
    "Reflection",
    "wordpress"
  ],
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/build/**",
    "**/wp-content/uploads/**"
  ],
  // VS Code's built-in PHP support duplicates Intelephense's completions and
  // shells out to a `php` binary this project deliberately does not install on
  // the host — every PHP file would show "PHP executable not found".
  "php.suggest.basic": false,
  "php.validate.enable": false,

  // phpsab.*, NOT phpcs.*: the phpsab extension reads only its own namespace.
  // The `phpcs.*` keys belong to a different, unmaintained extension and are
  // the single most common reason "PHPCS does nothing" in a WordPress project.
  "phpsab.snifferEnable": true,
  "phpsab.standard": "wordpress-headless/wp-content/plugins/blame-the-tech-core/phpcs.xml.dist",
  "phpsab.snifferShowSources": true,
  // Fixer OFF. `phpcbf` is a deliberate command (`composer phpcbf`), not a
  // save hook — the same reason formatOnSave is off for PHP below.
  "phpsab.fixerEnable": false,

  // ── JavaScript & TypeScript ──────────────────────────────────────────────
  //  The split `javascript.*` / `typescript.*` keys are deprecated — current
  //  VS Code unifies them under `js/ts.*`, which is also why they no longer
  //  need writing twice.
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.suggest.autoImports": true,
  "js/ts.format.enabled": false, // Prettier owns formatting
  // The workspace TypeScript lives in next-app/, not at the repo root. Pointed
  // at the root it resolves to nothing and VS Code silently falls back to its
  // own bundled version, which is how "it compiles in the editor but not in CI"
  // starts.
  "js/ts.tsdk.path": "next-app/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,

  // ── ESLint ───────────────────────────────────────────────────────────────
  "eslint.enable": true,
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    // @graphql-eslint runs over .graphql documents from Lesson 23.5 onward.
    "graphql"
  ],
  // Explicit, not `{ "mode": "auto" }`: eslint.config.mjs and the generated
  // schema path it reads are both relative to next-app/, and auto-detection
  // resolves them from the workspace root often enough to be a real problem.
  "eslint.workingDirectories": [
    {
      "directory": "next-app",
      "changeProcessCWD": true
    }
  ],

  // ── Language-specific ────────────────────────────────────────────────────
  //  PHP is the exception, and it is the whole reason this block exists.
  //  Prettier does not format PHP. Letting an unconfigured formatter reflow
  //  WordPress-standard PHP produces a diff PHPCS then complains about.
  "[php]": {
    "editor.defaultFormatter": null,
    "editor.formatOnSave": false,
    // WordPress Coding Standards mandates TABS. The repo-wide 2-space default
    // above would fail Generic.WhiteSpace.DisallowSpaceIndent on every line.
    "editor.insertSpaces": false,
    "editor.tabSize": 4
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "on"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },

  // ── Tailwind CSS (Module 11) ─────────────────────────────────────────────
  //  Tailwind 4 is CSS-first, so the extension finds the theme from
  //  `@import "tailwindcss"` with no config file. What it cannot find on its
  //  own is your class strings: this project writes almost none of them in a
  //  bare `className=`. They live inside `cn()` and `cva()` (Lessons 11.2 and
  //  11.4), and without the two patterns below autocomplete, the colour swatch
  //  and the hover preview all go silent in exactly the helpers the course
  //  tells you to use.
  "tailwindCSS.classAttributes": ["class", "className", "classNames", "containerClassName"],
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  // The lint rules are the point of installing this at all: they catch a
  // conflicting pair (`p-2 p-4`) and an invalid arbitrary value before the
  // class silently does nothing in the browser.
  "tailwindCSS.lint.cssConflict": "warning",
  "tailwindCSS.lint.invalidApply": "error",
  "tailwindCSS.lint.invalidConfigPath": "error",

  // ── Emmet ────────────────────────────────────────────────────────────────
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "typescript": "typescriptreact"
  }
}
