# =============================================================================
#  Blame The Tech — .gitignore
#
#  Two patterns in this file are themselves lessons. Read the comments.
# =============================================================================

# --- OS / editor --------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# --- Node / Next.js -----------------------------------------------------------
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.vercel/
.turbo/

# --- Test output --------------------------------------------------------------
coverage/
playwright-report/
test-results/
blob-report/
.agent-artifacts/
next-app/e2e/.auth/
fixtures/seeded.sql

# --- PHP / Composer -----------------------------------------------------------
vendor/
.phpunit.result.cache
.phpcs-cache
# The LOCAL override PHPCS reads before phpcs.xml.dist — Lesson 07.5
phpcs.xml
composer.phar

# =============================================================================
#  LESSON 1 — the allowlist pattern (Module 02)
#
#  WordPress core, uploads and third-party plugins are NOT ours and must never
#  be committed. But OUR two plugins live inside the same directory. So we
#  ignore the whole directory, then re-include our own with `!`.
#  Order matters: the negation must come AFTER the broad ignore.
# =============================================================================
wordpress-headless/wp-content/plugins/*
!wordpress-headless/wp-content/plugins/blame-the-tech-core/
!wordpress-headless/wp-content/plugins/blame-the-tech-blocks/

wordpress-headless/wp-content/uploads/
wordpress-headless/wp-content/upgrade/
wordpress-headless/wp-content/cache/
wordpress-headless/wp-content/languages/
wordpress-headless/wp-content/db-data/

# Generated from the environment at container boot. The template lives in the
# lesson, not in git.
wordpress-headless/wp-config.php

# Built block assets — regenerated by `npm run build` (Module 13)
wordpress-headless/wp-content/plugins/blame-the-tech-blocks/build/

# =============================================================================
#  LESSON 2 — `.env.example` is the ONLY env file that may exist in git
#
#  Every real env file is ignored. The tracked example contains variable NAMES
#  and `__CHANGE_ME__` placeholders — never a value. Real secrets are injected
#  at runtime: `fly secrets set`, Vercel environment variables, GitHub Actions
#  secrets. They never touch the filesystem in plaintext and never enter a
#  Docker image.
# =============================================================================
.env
.env.*
!.env.example

# Keys and certificates, in case one is ever generated locally
*.pem
*.key
*.p12
*.pfx
wp-salts.php
fly.secrets*

# =============================================================================
#  COURSE-AUTHORING ONLY — never ships to a student
#
#  `.course-authoring/` holds the style guide, the phase plan, the generated
#  content inventory and the three verification tools. None of it is of any use
#  to someone taking the course, so it stays out of the published repository.
#
#  NOTE TO THE AUTHOR: because this is ignored, git is NOT backing it up. If you
#  want history on it, track it on a separate `authoring` branch or in its own
#  repository. Losing PHASE-STATUS.md and phases-plan.md means losing the thread.
# =============================================================================
.course-authoring/

# --- Teacher-only -------------------------------------------------------------
ANSWERS.md
**/ANSWERS.md
